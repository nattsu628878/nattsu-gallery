---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineEditor from '../components/TimelineEditor.svelte';
---

<BaseLayout title="Time Line Editor - natʇsu editor">
  <header>
    <div class="header-row header-row-top">
      <h1 class="header-title">natʇsu editor / timeline</h1>
      <div class="mode-toggle">
        <a class="view-btn" href="/">Home</a>
        <a class="view-btn" href="/opus">Opus Editor</a>
        <a class="view-btn" href="http://127.0.0.1:4321/nattsu-gallery/timeline/" target="_blank" rel="noopener noreferrer">Open Time Line</a>
      </div>
    </div>
  </header>
  <main>
    <TimelineEditor client:only="svelte" />
  </main>
</BaseLayout>
