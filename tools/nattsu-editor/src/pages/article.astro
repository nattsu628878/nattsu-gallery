---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Article Sync - natʇsu editor">
  <header>
    <div class="header-row header-row-top">
      <h1 class="header-title">natʇsu editor / article</h1>
      <div class="mode-toggle">
        <a class="view-btn" href="/">Home</a>
        <a class="view-btn" href="/opus">Opus Editor</a>
        <a class="view-btn" href="/timeline">Time Line Editor</a>
        <a class="view-btn" href="http://127.0.0.1:4321/nattsu-gallery/article/" target="_blank" rel="noopener noreferrer">Open Article</a>
      </div>
    </div>
  </header>
  <main class="article-sync">
    <section class="sync-card">
      <div class="sync-actions">
        <button id="sync-btn" type="button" class="view-btn sync-btn">Obsidian 同期を実行</button>
        <span id="sync-state" class="sync-state">状態: 未取得</span>
      </div>
      <p class="sync-note">`sync-obsidian.sh` を実行し、記事Markdownとアセットを同期します。</p>
    </section>

    <section class="status-card">
      <h2>Markdown 状況</h2>
      <div id="summary" class="summary-grid"></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>File</th><th>Updated</th><th>Size</th></tr>
          </thead>
          <tbody id="file-rows"></tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    // @ts-nocheck
    const syncBtn = /** @type {HTMLButtonElement | null} */ (document.getElementById('sync-btn'));
    const syncState = /** @type {HTMLSpanElement | null} */ (document.getElementById('sync-state'));
    const summary = /** @type {HTMLDivElement | null} */ (document.getElementById('summary'));
    const rows = /** @type {HTMLTableSectionElement | null} */ (document.getElementById('file-rows'));
    if (!syncBtn || !syncState || !summary || !rows) throw new Error('article sync ui not found');

    /** @param {number} bytes */
    const formatBytes = (bytes) => {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    };

    /** @param {any} payload */
    const renderStatus = (payload) => {
      const status = payload?.status;
      if (!status) return;
      summary.innerHTML = `
        <div class="summary-item"><span>Directory</span><strong>${status.directory}</strong></div>
        <div class="summary-item"><span>Markdown files</span><strong>${status.fileCount}</strong></div>
        <div class="summary-item"><span>Total size</span><strong>${formatBytes(status.totalBytes)}</strong></div>
        <div class="summary-item"><span>Latest update</span><strong>${status.latestUpdatedAt ?? '-'}</strong></div>
      `;
      rows.innerHTML = '';
      for (const file of status.files) {
        rows.innerHTML += `
          <tr>
            <td>${file.name}</td>
            <td>${file.updatedAt}</td>
            <td>${formatBytes(file.sizeBytes)}</td>
          </tr>
        `;
      }
    };

    const fetchStatus = async () => {
      syncState.textContent = '状態: 読み込み中...';
      const res = await fetch('/api/article-sync');
      const data = await res.json();
      if (!res.ok || !data?.ok) throw new Error(data?.error ?? 'status fetch failed');
      renderStatus(data);
      syncState.textContent = '状態: 取得完了';
    };

    const runSync = async () => {
      syncBtn.disabled = true;
      syncState.textContent = '状態: 同期実行中...';
      try {
        const res = await fetch('/api/article-sync', { method: 'POST' });
        const data = await res.json();
        if (!res.ok || !data?.ok) throw new Error(data?.error ?? 'sync failed');
        renderStatus(data);
        syncState.textContent = '状態: 同期完了';
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        syncState.textContent = `状態: 失敗 (${message})`;
      } finally {
        syncBtn.disabled = false;
      }
    };

    syncBtn.addEventListener('click', runSync);
    fetchStatus().catch((error) => {
      const message = error instanceof Error ? error.message : String(error);
      syncState.textContent = `状態: 失敗 (${message})`;
    });
  </script>
</BaseLayout>

<style>
  .article-sync { display: grid; gap: 0.8rem; }
  .sync-card, .status-card {
    border: 1px solid #e1e1e1;
    background: #fff;
    padding: 0.8rem;
  }
  .sync-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .sync-btn { cursor: pointer; }
  .sync-btn:disabled { opacity: 0.6; cursor: wait; }
  .sync-state { font-size: 0.78rem; color: #666; }
  .sync-note { margin-top: 0.45rem; font-size: 0.75rem; color: #666; }
  .status-card h2 { font-size: 0.9rem; margin-bottom: 0.6rem; color: #4d6b5f; }
  .summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; margin-bottom: 0.7rem; }
  .summary-item { border: 1px solid #ececec; padding: 0.45rem 0.5rem; display: grid; gap: 0.2rem; }
  .summary-item span { font-size: 0.72rem; color: #666; }
  .summary-item strong { font-size: 0.78rem; color: #333; word-break: break-all; }
  .table-wrap { border: 1px solid #ececec; overflow: auto; max-height: 58vh; }
  table { width: 100%; border-collapse: collapse; font-size: 0.76rem; }
  th, td { text-align: left; padding: 0.42rem 0.5rem; border-bottom: 1px solid #f0f0f0; }
  thead th { background: #fafafa; position: sticky; top: 0; z-index: 1; }
  @media (max-width: 768px) {
    .summary-grid { grid-template-columns: 1fr; }
  }
</style>
