---
const { title = 'natʇsu editor' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      :root {
        --accent: #628878;
        --accent-dark: #4d6b5f;
        --accent-bg: rgba(98, 136, 120, 0.15);
        --header-btn-height: 28px;
        --header-btn-padding-x: 0.6rem;
      }
      html { scrollbar-gutter: stable; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f5f5f5;
        color: #333;
        font-size: 14px;
        line-height: 1.4;
      }
      .container { max-width: 1200px; margin: 0 auto; padding: 1rem; }
      header {
        background: #fff;
        padding: 0.4rem 1rem;
        margin: -1rem -1rem 1rem -1rem;
        border-bottom: 2px solid var(--accent);
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
        gap: 0.5rem;
      }
      .header-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
      }
      .header-row-top { justify-content: space-between; }
      .header-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--accent);
      }
      .mode-toggle { display: flex; gap: 0.25rem; margin-left: auto; flex-wrap: wrap; }
      .view-btn {
        height: var(--header-btn-height);
        padding: 0 var(--header-btn-padding-x);
        border: 1px solid #ddd;
        background: #fff;
        color: #666;
        font-size: 0.7rem;
        font-weight: 500;
        border-radius: 3px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        line-height: 1;
      }
      .view-btn:hover { border-color: var(--accent); color: var(--accent); }
      .view-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
      .editor-links {
        margin-top: 0.9rem;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
      }
      .editor-card {
        display: block;
        border: 1px solid #e1e1e1;
        background: #fff;
        padding: 0.75rem 0.8rem;
        text-decoration: none;
        color: inherit;
      }
      .editor-card:hover { border-color: var(--accent); }
      .editor-card h2 { margin: 0 0 0.25rem; color: var(--accent-dark); font-size: 0.92rem; }
      .editor-card p { margin: 0; color: #666; font-size: 0.78rem; }
      .editor-iframe { width: 100%; min-height: calc(100vh - 90px); border: 1px solid #e1e1e1; background: #fff; margin-top: 0.7rem; }
      @media (max-width: 768px) {
        .container { padding: 0.65rem; }
        header {
          margin: -0.65rem -0.65rem 0.75rem -0.65rem;
          padding: 0.5rem 0.65rem;
          overflow-x: auto;
          overflow-y: hidden;
        }
        .header-row {
          width: max-content;
          min-width: 100%;
        }
        .header-title { font-size: 0.92rem; }
        .view-btn { font-size: 0.68rem; }
        .editor-links { grid-template-columns: 1fr; }
      }
      @media (max-width: 480px) {
        .container { padding: 0.5rem; }
        header {
          margin: -0.5rem -0.5rem 0.65rem -0.5rem;
          padding: 0.45rem 0.5rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <slot />
    </div>
  </body>
</html>
