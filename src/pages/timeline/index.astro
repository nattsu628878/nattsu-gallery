---
import TimelineView from '../../components/timeline/TimelineView.svelte';
import '../../styles/pages/timeline.css';
import { parseTimelineMarkdownFiles } from '../../lib/timeline/markdown';

const markdownModules = import.meta.glob('../../data/timeline/**/*.md', {
  query: '?raw',
  import: 'default',
  eager: true
}) as Record<string, string>;
const assetModules = import.meta.glob('../../data/timeline/data/**/*', {
  query: '?url',
  import: 'default',
  eager: true
}) as Record<string, string>;

const assetMap = new Map<string, string>();
Object.entries(assetModules).forEach(([filePath, url]) => {
  const normalized = filePath.replace(/\\/g, '/');
  const marker = '/src/data/timeline/data/';
  const rel = normalized.includes(marker)
    ? normalized.split(marker)[1]
    : normalized.split('/').slice(-1)[0];
  const key = rel.toLowerCase();
  const file = rel.split('/').pop()?.toLowerCase() || key;
  assetMap.set(key, String(url));
  assetMap.set(file, String(url));
});

const items = parseTimelineMarkdownFiles(markdownModules, assetMap);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Time Line - natʇsu</title>
  </head>
  <body>
    <TimelineView client:only="svelte" items={items} />
  </body>
</html>
