---
import TimelineView from '../../components/timeline/TimelineView.svelte';
import '../../styles/pages/timeline.css';
import { parseTimelineMarkdownFiles } from '../../lib/timeline/markdown';

const markdownModules = import.meta.glob('../../data/timeline/content/**/*.md', {
  query: '?raw',
  import: 'default',
  eager: true
}) as Record<string, string>;

const items = parseTimelineMarkdownFiles(markdownModules);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Time Line - natʇsu</title>
  </head>
  <body>
    <TimelineView client:only="svelte" items={items} />
  </body>
</html>
