---
import ArticleView from '../../components/article/ArticleView.svelte';
import '../../styles/pages/article.css';
import {
  buildArticleCollections,
  convertObsidianLinks,
  renderMarkdown,
  toBasePath
} from '../../lib/article/markdown';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => toBasePath(base, path);
const MARKDOWN_ROOT = '/src/data/article/markdown/';

const markdownModules = import.meta.glob('../../data/article/markdown/**/*.md', {
  query: '?raw',
  import: 'default',
  eager: true
}) as Record<string, string>;
const assetModules = import.meta.glob('../../data/article/markdown/data/**/*', {
  query: '?url',
  import: 'default',
  eager: true
}) as Record<string, string>;

const { docs, docMap, assetMap } = buildArticleCollections(markdownModules, assetModules, MARKDOWN_ROOT);

function toArticleHref(target: string) {
  return withBase(`article/_home/${encodeURIComponent(target)}`);
}

const articles = await Promise.all(
  docs.map(async (doc) => ({
    id: doc.id,
    title: doc.id,
    breadcrumb: `_home/${doc.id}`,
    html: await renderMarkdown(convertObsidianLinks(doc.raw, docMap, assetMap, toArticleHref))
  }))
);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Article - natʇsu</title>
  </head>
  <body>
    <ArticleView client:only="svelte" articles={articles} />
  </body>
</html>
