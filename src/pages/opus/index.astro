---
import OpusView from '../../components/opus/OpusView.svelte';
import '../../styles/pages/opus.css';
import { parseOpusMarkdownFiles, type OpusAssetEntry } from '../../lib/opus/markdown';

const markdownModules = import.meta.glob('../../data/opus/content/**/*.md', {
  query: '?raw',
  import: 'default',
  eager: true
}) as Record<string, string>;
const assetModules = import.meta.glob('../../data/opus/content/data/**/*', {
  query: '?url',
  import: 'default',
  eager: true
}) as Record<string, string>;

const assetMap = new Map<string, string>();
const assetEntries: OpusAssetEntry[] = [];
Object.entries(assetModules).forEach(([filePath, url]) => {
  const normalized = filePath.replace(/\\/g, '/');
  const marker = '/src/data/opus/content/data/';
  const rel = normalized.includes(marker)
    ? normalized.split(marker)[1]
    : normalized.split('/').slice(-1)[0];
  const key = rel.toLowerCase();
  const file = rel.split('/').pop()?.toLowerCase() || key;
  const stem = file.replace(/\.[^.]+$/i, '');
  assetEntries.push({ rel, url: String(url) });
  assetMap.set(key, String(url));
  assetMap.set(file, String(url));
  if (stem) assetMap.set(stem, String(url));
});

const items = parseOpusMarkdownFiles(markdownModules, assetMap, assetEntries);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>natʇsu</title>
  </head>
  <body>
    <OpusView client:only="svelte" items={items} />
  </body>
</html>
