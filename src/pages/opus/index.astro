---
import OpusView from '../../components/opus/OpusView.svelte';
import '../../styles/pages/opus.css';
import { parseOpusMarkdownFiles } from '../../lib/opus/markdown';

const markdownModules = import.meta.glob('../../data/opus/markdown/**/*.md', {
  query: '?raw',
  import: 'default',
  eager: true
}) as Record<string, string>;

const items = parseOpusMarkdownFiles(markdownModules);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>natʇsu</title>
  </head>
  <body>
    <OpusView client:only="svelte" items={items} />
  </body>
</html>
